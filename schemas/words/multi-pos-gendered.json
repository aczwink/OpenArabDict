{    
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "Multi POS gendered definition",
    "description": "JSON Schema for gendered words with multiple part-of-speeches definitions",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "pos": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": ["adjective", "noun"]
                    },
                    "translations": {
                        "type": "array",
                        "items": {
                            "oneOf": [
                                {
                                    "$ref": "../translations/OpenArabDictHW4TranslationEntry.json"
                                }
                            ]
                        }
                    }
                },
                "required": ["type", "translations"]
            }
        },
        "text": {
            "type": "string"
        }
    },
    "required": ["pos", "text"]
}